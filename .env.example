# ============================================================
# Task 1: Multimodal retrieval (Qwen-VL family)
# ============================================================
# Backend selector -- "local" | "hosted" | "mock". Leave unset for
# auto-detection: hosted if DASHSCOPE_API_KEY is set, else mock.
QWEN_VL_BACKEND=

# Only used if QWEN_VL_BACKEND=hosted (Alibaba DashScope API).
DASHSCOPE_API_KEY=

# Only used if QWEN_VL_BACKEND=local. Overrides the default
# Qwen/Qwen2-VL-2B-Instruct Hugging Face model name.
QWEN_VL_LOCAL_MODEL=

# ============================================================
# Task 2: MCP agent (Claude / local Ollama / offline)
# ============================================================
# Backend selector -- "claude" | "ollama" | "offline". Leave unset for
# auto-detection: claude if ANTHROPIC_API_KEY is set, else ollama if a
# local Ollama server is reachable, else offline rule-based fallback.
LLM_BACKEND=

# Only used if LLM_BACKEND=claude (or auto-detected).
ANTHROPIC_API_KEY=

# Only used if LLM_BACKEND=ollama (or auto-detected). Overrides the
# default qwen2.5:7b Ollama model name.
OLLAMA_MODEL=

# Optional override: path to the SQLite DB file used by the MCP server.
# Defaults to task2_mcp_agent/data/company.db if unset.
DB_PATH=
